{
  "expo": {
    "name": "Church Census",
    "slug": "church-census-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#6200ee",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.church.census"
    },
    "android": {
      "package": "com.church.census",
      "backgroundColor": "#6200ee"
    },
    "extra": {
      "eas": {
        "projectId": "72271bf5-3c11-44e4-a17f-20b4b84c5f77"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0"
          }
        }
      ]
    ]
  }
}
